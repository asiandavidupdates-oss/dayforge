# Copy to .env — NEVER commit a real .env file.
# A long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
# Local dev: leave unset to use SQLite (dayforge.db).
# Production (Render/Railway): set to your Postgres URL, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dayforge
DATABASE_URL=
# Optional: allow the forgot-password endpoint to return the reset token
# in its response (local dev / testing ONLY). Keep false/absent in production.
ALLOW_RESET_TOKEN_IN_RESPONSE=false
# Optional SMTP for real password-reset emails (not implemented as a mailer
# here; if unset, reset tokens are NOT emailed — see API.md).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
